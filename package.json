{
  "name": "@codepg/ui-lib",
  "version": "0.4.2",
  "description": "The shared UI surface: components, icons, actions and the i18n store.",
  "license": "MIT",
  "author": "codepg",
  "keywords": [
    "svelte",
    "sveltekit",
    "ui",
    "components",
    "design-system"
  ],
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#showcase/*": "./src/app/showcase/*",
    "#appLib/*": "./src/app/*"
  },
  "svelte": "./dist/index.js",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "svelte": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./components/use-*.svelte": {
      "types": "./dist/components/use-*.svelte.d.ts",
      "svelte": "./dist/components/use-*.svelte.js",
      "default": "./dist/components/use-*.svelte.js"
    },
    "./components/*.svelte": {
      "types": "./dist/components/*.svelte.d.ts",
      "svelte": "./dist/components/*.svelte",
      "default": "./dist/components/*.svelte"
    },
    "./icons/*.svelte": {
      "types": "./dist/icons/*.svelte.d.ts",
      "svelte": "./dist/icons/*.svelte",
      "default": "./dist/icons/*.svelte"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite dev --host",
    "build": "svelte-kit sync && vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo && node tools/check-test-layout.mjs && node tools/check-showcase-props.mjs && node tools/check-size-literals.mjs && node tools/check-markup-text.mjs && node tools/check-shared-parity.mjs --strict",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest",
    "package": "node tools/build-package.mjs",
    "publish:local": "npm run package && npm publish --registry http://localhost:4873/ --tag latest --ignore-scripts",
    "publish:check": "npm run check && npm run build && npm test && npm run package && node tools/check-package.mjs",
    "audit": "npm audit",
    "format": "prettier --write '**/*.{js,ts,svelte}'",
    "e2e": "node tools/run-e2e.mjs",
    "deploy": "node scripts/deploy.mjs",
    "heartbeat": "node scripts/heartbeat.mjs",
    "env:sync:vercel": "node ./scripts/sync-vercel-env.mjs",
    "env:sync:cloudflare": "node ./scripts/sync-cloudflare-env.mjs",
    "schema:apply": "node ./scripts/apply-schema.mjs",
    "prepublishOnly": "node tools/check-publish-auth.mjs && npm run publish:check"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@uiw/codemirror-theme-github": "^4.25.10",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/autocomplete": {
      "optional": true
    },
    "@codemirror/commands": {
      "optional": true
    },
    "@codemirror/lang-html": {
      "optional": true
    },
    "@codemirror/lang-javascript": {
      "optional": true
    },
    "@codemirror/lang-json": {
      "optional": true
    },
    "@codemirror/lang-markdown": {
      "optional": true
    },
    "@codemirror/lang-xml": {
      "optional": true
    },
    "@codemirror/lang-yaml": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/search": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@uiw/codemirror-theme-github": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/runtime": "^8.0.5",
    "dayjs": "^1.11.23",
    "esm-env": "^1.2.2",
    "svelte-sonner": "^1.1.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@neondatabase/serverless": "^1.1.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/adapter-vercel": "^7.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.4.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@uiw/codemirror-theme-github": "^4.25.10",
    "@vitest/coverage-v8": "^5.0.3",
    "better-sqlite3": "^13.0.3",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "publint": "^0.3.25",
    "svelte": "^5.57.2",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true,
    "workerd": true
  },
  "overrides": {
    "glob": "^14.0.3"
  }
}
