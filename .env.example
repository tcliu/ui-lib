# Environment knobs. This file is documentation only and is never loaded;
# copy it to `.env` (git-ignored) to override locally — Vite loads `.env`
# automatically during `npm run dev`.
#
# For production, create `.env.vercel` (git-ignored) holding the values to
# push via `npm run env:sync:vercel`. It is also where the deploy script
# reads APP_BASE_URL from.

# Public URL the app is reachable at. deploy.mjs points the Vercel project's
# production domain at its hostname after each deploy; set it in `.env.vercel`.
# APP_BASE_URL=https://<your-alias>.vercel.app

# Cloudflare Pages target (`npm run deploy -- --target cloudflare`, CF_PAGES=1
# build on the existing Neon backend). Cloudflare-only values live in the
# git-ignored `.env.cloudflare` (CLOUDFLARE_PROJECT), overlaid
# on `.env.prod`; sync with `npm run env:sync:cloudflare`. The live URL is
# the Pages production hostname derived from CLOUDFLARE_PROJECT — no
# APP_BASE_URL exists on this target.
# CLOUDFLARE_PROJECT=ui-lib
# CLOUDFLARE_ACCOUNT_ID is required by the deploy flow: the Cloudflare steps
# resolve the Pages production branch, list the project, and sync env through
# the account API, even with an unscoped token. Find it in the Cloudflare
# dashboard URL (dash.cloudflare.com/<id>); keep it in the shell env or
# `.env.local` (local-only), or in `.env.cloudflare` (synced as a project secret).
# CLOUDFLARE_ACCOUNT_ID=

# Vercel project slug. When `.vercel/project.json` is missing, `npm run
# deploy` links the checkout automatically: `--project`, then this value,
# then an interactive prompt (the answer is saved back here before the env
# sync, so later deploys skip the question). Updating it and redeploying
# switches the link interactively after confirmation; a non-interactive run
# requires an explicit `--project <name>` to opt in.
# VERCEL_PROJECT=ui-lib

# Worktree dev tag. Written to `.env.local` by scripts/create-worktree.mjs;
# shows as a corner badge in dev so worktrees are distinguishable at a glance.
# DEV_TAG=feat-my-change

# Database. Dev is always local SQLite; prod is always Neon. Apply the schema
# in `sql/schema.sql` explicitly with `npm run schema:apply` — boot never runs
# DDL. `SCHEMA_VERIFY_TABLES` lists the tables that command must find.
# PROFILE=dev
# SQLITE_PATH=.data/ui-lib-dev.sqlite
# SCHEMA_NAME=public
# SCHEMA_VERIFY_TABLES=app_meta
# DATABASE_URL=postgres://user:password@host/neondb

# Self-card active flag served as the `active` field of GET /api/info
# (default true). APP_ACTIVE=false opts this instance out of catalog scans.
# APP_ACTIVE=true
